{
  "Document header": {
    "prefix": ["header", "= title"],
    "body": ["= ${1:Document title}", "${2:Author Name} <${3:author@example.org}>", "v${4:1.0}, ${5:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}", ":toc:", ":imagesdir: ${6:images}", "", "$0"],
    "description": "Document header with author, revision and attributes"
  },
  "Section": { "prefix": "==", "body": ["== ${1:Section title}", "", "$0"], "description": "Level 1 section" },
  "Subsection": { "prefix": "===", "body": ["=== ${1:Subsection title}", "", "$0"], "description": "Level 2 section" },
  "Source block": { "prefix": ["source", "code"], "body": ["[source,${1:java}]", "----", "$0", "----"], "description": "Source code block with language" },
  "Fenced code": { "prefix": "```", "body": ["```${1:python}", "$0", "```"], "description": "Fenced source block" },
  "Literal block": { "prefix": "literal", "body": ["....", "$0", "...."], "description": "Literal block" },
  "Example block": { "prefix": "example", "body": [".${1:Title}", "====", "$0", "===="], "description": "Example block" },
  "Sidebar": { "prefix": "sidebar", "body": ["****", "$0", "****"], "description": "Sidebar block" },
  "Quote": { "prefix": "quote", "body": ["[quote, ${1:Author}, ${2:Source}]", "____", "$0", "____"], "description": "Quote with attribution" },
  "Passthrough": { "prefix": "pass", "body": ["++++", "$0", "++++"], "description": "Passthrough block" },
  "Formula block": { "prefix": "stem", "body": ["[${1|stem,latexmath,asciimath|}]", "++++", "$0", "++++"], "description": "STEM formula block" },
  "Inline formula": { "prefix": "stem:", "body": ["${1|stem,latexmath,asciimath|}:[$0]"], "description": "Inline STEM formula" },
  "Comment block": { "prefix": "comment", "body": ["////", "$0", "////"], "description": "Comment block" },
  "Note": { "prefix": "note", "body": ["NOTE: $0"], "description": "NOTE admonition" },
  "Tip": { "prefix": "tip", "body": ["TIP: $0"], "description": "TIP admonition" },
  "Important": { "prefix": "important", "body": ["IMPORTANT: $0"], "description": "IMPORTANT admonition" },
  "Warning": { "prefix": "warning", "body": ["WARNING: $0"], "description": "WARNING admonition" },
  "Caution": { "prefix": "caution", "body": ["CAUTION: $0"], "description": "CAUTION admonition" },
  "Admonition block": { "prefix": "admonition", "body": ["[${1|NOTE,TIP,IMPORTANT,WARNING,CAUTION|}]", "====", "$0", "===="], "description": "Multi-paragraph admonition" },
  "Image": { "prefix": "image", "body": ["image::${1:figure.png}[${2:Alt text}${3:,${4:300}}]"], "description": "Block image" },
  "Image with caption": { "prefix": "figure", "body": [".${1:Caption}", "image::${2:figure.png}[${3:Alt text}]"], "description": "Image with a caption" },
  "Inline image": { "prefix": "image:", "body": ["image:${1:icon.png}[${2:alt},${3:16}]"], "description": "Inline image" },
  "Include": { "prefix": "include", "body": ["include::${1:file.adoc}[${2:leveloffset=+1}]"], "description": "Include a file" },
  "Include tag": { "prefix": "includetag", "body": ["include::${1:file.java}[tag=${2:snippet}]"], "description": "Include a tagged region of a file" },
  "Link": { "prefix": "link", "body": ["link:${1:target}[${2:Text}]"], "description": "Link macro" },
  "URL": { "prefix": "url", "body": ["https://${1:example.org}[${2:Text}]"], "description": "URL with text" },
  "Cross reference": { "prefix": ["xref", "<<"], "body": ["<<${1:anchor}${2:,${3:Text}}>>"], "description": "Cross reference" },
  "Anchor": { "prefix": "anchor", "body": ["[[${1:id}]]"], "description": "Block anchor" },
  "Footnote": { "prefix": "footnote", "body": ["footnote:[${1:Text}]"], "description": "Footnote" },
  "Table": { "prefix": "table", "body": ["[cols=\"${1:1,1}\", options=\"header\"]", "|===", "|${2:Header 1} |${3:Header 2}", "", "|${4:Cell} |${5:Cell}", "|==="], "description": "Table with header" },
  "CSV table": { "prefix": "csv", "body": ["[%header,format=csv]", "|===", "${1:Header 1},${2:Header 2}", "${3:a},${4:b}", "|==="], "description": "CSV table" },
  "Bulleted list": { "prefix": "ul", "body": ["* ${1:Item}", "* ${2:Item}", "* $0"], "description": "Bulleted list" },
  "Numbered list": { "prefix": "ol", "body": [". ${1:Item}", ". ${2:Item}", ". $0"], "description": "Numbered list" },
  "Task list": { "prefix": "tasks", "body": ["* [ ] ${1:Task}", "* [x] ${2:Done}", "* [ ] $0"], "description": "Task list" },
  "Description list": { "prefix": "dl", "body": ["${1:Term}:: ${2:Definition}", "${3:Term}:: $0"], "description": "Description list" },
  "Callouts": { "prefix": "callout", "body": ["[source,${1:java}]", "----", "${2:code} // <1>", "----", "<1> ${3:Explanation}"], "description": "Source block with a callout" },
  "Keyboard": { "prefix": "kbd", "body": ["kbd:[${1:Ctrl+S}]"], "description": "Keyboard shortcut (needs :experimental:)" },
  "Button": { "prefix": "btn", "body": ["btn:[${1:OK}]"], "description": "UI button (needs :experimental:)" },
  "Menu": { "prefix": "menu", "body": ["menu:${1:File}[${2:Save as} > ${3:PDF}]"], "description": "Menu path (needs :experimental:)" },
  "Thematic break": { "prefix": "hr", "body": ["'''", ""], "description": "Thematic break" },
  "Page break": { "prefix": "pagebreak", "body": ["<<<", ""], "description": "Page break" },
  "Table of contents": { "prefix": "toc", "body": ["toc::[]"], "description": "Table of contents macro (needs :toc: macro)" },
  "Attribute": { "prefix": "attr", "body": [":${1:name}: ${2:value}"], "description": "Attribute entry" },
  "Conditional": { "prefix": "ifdef", "body": ["ifdef::${1:attribute}[]", "$0", "endif::[]"], "description": "Conditional content" }
}
